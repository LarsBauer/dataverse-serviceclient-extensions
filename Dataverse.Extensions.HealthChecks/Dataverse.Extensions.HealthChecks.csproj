<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BauerApps.Dataverse.Extensions</RootNamespace>

    <PackageId>BauerApps.Dataverse.Extensions.HealthChecks</PackageId>
    <Version>1.0.0</Version> <!-- x-release-please-version -->
    <Description>ASP.NET Core health check for Microsoft Dataverse using the WhoAmI request.</Description>
    <Authors>Lars Bauer</Authors>
    <Copyright>Copyright (c) Lars Bauer</Copyright>
    <RepositoryUrl>https://github.com/LarsBauer/dataverse-serviceclient-extensions.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/LarsBauer/dataverse-serviceclient-extensions</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/LarsBauer/dataverse-serviceclient-extensions/blob/main/Dataverse.Extensions.HealthChecks/CHANGELOG.md</PackageReleaseNotes>
    <PackageTags>dataverse;dynamics;powerplatform;healthchecks;aspnetcore</PackageTags>
  </PropertyGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="CHANGELOG.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>

