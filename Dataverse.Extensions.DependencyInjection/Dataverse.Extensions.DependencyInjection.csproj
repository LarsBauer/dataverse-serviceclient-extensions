<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BauerApps.Dataverse.Extensions</RootNamespace>

    <PackageId>BauerApps.Dataverse.Extensions.DependencyInjection</PackageId>
    <Version>1.3.0</Version> <!-- x-release-please-version -->
    <Description>Dependency injection extensions for Microsoft Dataverse ServiceClient.</Description>
    <Authors>Lars Bauer</Authors>
    <Copyright>Copyright (c) Lars Bauer</Copyright>
    <RepositoryUrl>https://github.com/LarsBauer/dataverse-serviceclient-extensions.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/LarsBauer/dataverse-serviceclient-extensions</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/LarsBauer/dataverse-serviceclient-extensions/blob/main/Dataverse.Extensions.DependencyInjection/CHANGELOG.md</PackageReleaseNotes>
    <PackageTags>dataverse;dynamics;powerplatform;dependency-injection</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>$(MSBuildProjectName).Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.9" />
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="CHANGELOG.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
